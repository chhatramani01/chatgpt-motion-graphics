{
  "name": "chatgpt-motion-graphics",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT-first motion studio: 86 complete style prompts, 46 original video agents, deterministic rendering with synchronized audio",
  "scripts": {
    "check": "node scripts/check.mjs",
    "render": "node scripts/render.mjs",
    "demo": "node scripts/demo.mjs",
